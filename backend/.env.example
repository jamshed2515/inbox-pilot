PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_scheduler
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Rate Limiting & Concurrency
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Slack Integration & OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
SLACK_DEFAULT_CHANNEL=#email-alerts
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Google OAuth & Authentication (Phase F)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
JWT_SECRET=reachinbox_email_scheduler_jwt_secret_key_2026
JWT_EXPIRES_IN=7d


