PORT=5000
NODE_ENV=development
# Frontend URL (e.g. http://localhost:5173 for local, https://inbox-pilot-dun.vercel.app for production)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_scheduler
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/email_scheduler

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Elasticsearch (Active locally with Docker Compose; set ELASTICSEARCH_ENABLED=false for Render Free)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Email Provider Configuration (Assignment Requirement: Fake SMTP via Ethereal Email)
# Options: ethereal (default) | brevo | custom
EMAIL_PROVIDER=ethereal

# Option A: Zero-Config Dynamic Ethereal (Default)
# If ETHEREAL_USER & ETHEREAL_PASS are left blank, Nodemailer automatically provisions
# a dynamic Ethereal test account on startup and generates genuine preview URLs.
ETHEREAL_USER=
ETHEREAL_PASS=

# Option B: Optional Real SMTP Relay (e.g. Brevo)
# To use real email delivery instead of Ethereal, set EMAIL_PROVIDER=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_brevo_account_email@example.com
SMTP_PASS=your_brevo_smtp_master_key
SMTP_FROM="ReachInbox Scheduler" <your_verified_sender@example.com>

# Rate Limiting & Concurrency
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Slack Integration & OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
SLACK_DEFAULT_CHANNEL=#email-alerts
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# ==============================================================================
# Google OAuth 2.0 & JWT Authentication
# ==============================================================================
# Required to enable real Google OAuth login alongside One-Click Demo Login:
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Configure OAuth Consent Screen:
#    - User Type: External
#    - Scopes: .../auth/userinfo.email, .../auth/userinfo.profile, openid
#    - Publishing status: Testing (add your test Google email as Test User)
# 3. Create Credentials -> OAuth client ID -> Application type: Web application
# 4. Add Authorized JavaScript origins:
#    - Local: http://localhost:5173
#    - Production: https://<your-frontend-domain> (e.g., https://inbox-pilot-dun.vercel.app)
# 5. Add Authorized redirect URIs (MUST match GOOGLE_REDIRECT_URI exactly):
#    - Local: http://localhost:5000/api/auth/google/callback
#    - Production: https://<your-backend-domain>/api/auth/google/callback
# 6. Copy Client ID and Client Secret into your backend/.env:
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
JWT_SECRET=reachinbox_email_scheduler_jwt_secret_key_2026
JWT_EXPIRES_IN=7d


